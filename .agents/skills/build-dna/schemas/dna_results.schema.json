{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-criterion DNA decisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "payload_digest",
    "criteria"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "decision",
          "synthesis",
          "confidence",
          "evidence",
          "filter_reason",
          "when",
          "action",
          "selection",
          "validation",
          "condition_variation",
          "target_step"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "decision": {
            "enum": [
              "keep",
              "drop"
            ]
          },
          "synthesis": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "High",
              "Medium",
              "Low"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "part_id",
                "result_excerpt",
                "role"
              ],
              "properties": {
                "part_id": {
                  "type": "string",
                  "pattern": "^Part[1-9][0-9]*$"
                },
                "result_excerpt": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "support",
                    "variation",
                    "exception",
                    "unresolved"
                  ]
                }
              }
            }
          },
          "filter_reason": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "selection": {
            "type": "string"
          },
          "validation": {
            "type": "string"
          },
          "condition_variation": {
            "type": "string"
          },
          "target_step": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "keep"
                }
              }
            },
            "then": {
              "properties": {
                "confidence": {
                  "enum": [
                    "High",
                    "Medium"
                  ]
                },
                "evidence": {
                  "minItems": 2
                },
                "filter_reason": {
                  "const": ""
                },
                "when": {
                  "minLength": 1
                },
                "action": {
                  "minLength": 1
                },
                "selection": {
                  "minLength": 1
                },
                "validation": {
                  "minLength": 1
                },
                "condition_variation": {
                  "minLength": 1
                },
                "target_step": {
                  "enum": [
                    "STEP 1",
                    "STEP 2",
                    "STEP 3",
                    "STEP 4"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "filter_reason": {
                  "minLength": 1
                },
                "when": {
                  "const": ""
                },
                "action": {
                  "const": ""
                },
                "selection": {
                  "const": ""
                },
                "validation": {
                  "const": ""
                },
                "condition_variation": {
                  "const": ""
                },
                "target_step": {
                  "const": ""
                }
              }
            }
          }
        ]
      }
    }
  }
}
